{
  "expo": {
    "name": "Bonis Musik",
    "slug": "bonis-musik",
    "owner": "bonismusic2-crypto",
    "scheme": "bonismusik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "eas": {
        "projectId": "4bc28f8a-61d4-47a5-8dfd-6a67dddac0dd"
      }
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bonismusik.app"
    },
    "android": {
      "package": "com.bonismusik.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "notification": {
      "icon": "./assets/notification.png",
      "color": "#C59B27"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification.png",
          "color": "#C59B27"
        }
      ]
    ]
  }
}
